# Copy this file to `.env` in the backend/ directory and fill in real values.
# NEVER commit the actual .env file.

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model routing: which Claude model each stage should use by default.
# Cheaper/faster models for high-volume, low-risk tasks (e.g. question generation,
# aptitude grading); stronger models for tasks needing deeper reasoning
# (e.g. technical interview follow-ups, final verdict synthesis).
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_STRONG=claude-sonnet-5

# --- Coding sandbox (integrated in a later stage) ---
CODE_EXECUTION_PROVIDER=judge0
JUDGE0_API_URL=
JUDGE0_API_KEY=
PISTON_API_URL=

# --- Mock mode (Day 3: coding round) ---
# true (default): Claude-backed stage agents that support it (currently the
# coding-round problem generator) use a deterministic offline mock instead
# of calling the Anthropic API. Set to false once credits/a valid
# ANTHROPIC_API_KEY are available to use the real Claude-backed agent.
MOCK_MODE=true

# --- App / Server ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite file path, relative to the project root (parent of backend/).
# Resolves to the top-level database/ folder regardless of the working
# directory the server is started from.
DATABASE_URL=sqlite:///database/interview_agent.db
